# Copy this file to .env and fill in your real values. Never publish .env.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/elevance_staffing
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_NAME=Elevance Administrator
ADMIN_EMAIL=admin@elevancestaffing.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
# Set true only if your host terminates HTTPS in front of Node.
TRUST_PROXY=false
